# Application Configuration
FLASK_ENV=development
FLASK_APP=app:create_app
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///news_intelligence.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_intelligence

# Redis / Celery (Optional, defaults to in-memory/in-process executor if unavailable)
REDIS_URL=redis://localhost:6379/0

# Model Configuration
MODEL_DEVICE=auto
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
DEFAULT_TRANSLATION_MODEL_TAMIL=suriya7/English-to-Tamil

# Limits & Security
MAX_ARTICLE_SIZE_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=60
AUDIO_CACHE_DIR=audio_cache
CACHE_TTL_SECONDS=3600

# Feature Flags
ENABLE_MULTI_SOURCE=true
ENABLE_COMPARISON=true
ENABLE_TTS=true
ENABLE_TRANSLATION=true
ENABLE_BACKGROUND_JOBS=true

# Logging
LOG_LEVEL=INFO
